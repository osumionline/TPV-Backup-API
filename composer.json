{
  "name": "osumionline/tpv-backup-api",
  "description": "API backend de Osumi TPV Backup.",
  "type": "project",
  "keywords": [
    "osumi",
    "tpv",
    "backup"
  ],
  "homepage": "https://github.com/osumionline/TPV-Backup-API",
  "license": "MIT",
  "authors": [
    {
      "name": "Iñigo Gorosabel",
      "homepage": "https://osumi.es",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.5",
    "osumionline/framework": "^9.9.1",
    "osumionline/plugin-token": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3"
  },
  "autoload": {
    "psr-4": {
      "Osumi\\OsumiFramework\\App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Osumi\\OsumiFramework\\App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "osumionline/plugin-updater": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
